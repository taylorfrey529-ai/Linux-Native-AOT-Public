<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>evermore</AssemblyName>
    <RootNamespace>Evermore.Cli</RootNamespace>
    <Version>0.10.0</Version>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
    <StripSymbols>true</StripSymbols>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="[2.0.10]" />
    <ProjectReference Include="../EasternKingdoms.Simulation/EasternKingdoms.Simulation.csproj" />
    <ProjectReference Include="../Evermore.Azeroth.Simulation/Evermore.Azeroth.Simulation.csproj" />
    <ProjectReference Include="../Evermore.Lunara.Core/Evermore.Lunara.Core.csproj" />
    <ProjectReference Include="../Evermore.Mmo.Core/Evermore.Mmo.Core.csproj" />
    <ProjectReference Include="../Evermore.Solune.Core/Evermore.Solune.Core.csproj" />
    <ProjectReference Include="../Omega.Recursive/Omega.Recursive.csproj" />
  </ItemGroup>
</Project>
